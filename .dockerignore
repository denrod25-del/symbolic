# Version control
.git
.gitignore
.gitattributes

# Node
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output
.next
out

# Local env files (Coolify supplies real values at runtime)
.env
.env*.local
.env.development
.env.test

# Test / coverage artifacts
coverage
.nyc_output
playwright-report
test-results
tests/**/screenshots
tests/**/snapshots

# Local dev databases (pglite)
local.db
*.db-journal
*.db-shm
*.db-wal

# Editor / OS junk
.vscode
.idea
.DS_Store
Thumbs.db

# Storybook build
storybook-static

# Docker meta (avoid recursive copy)
Dockerfile
.dockerignore

# CI / docs / other things not needed in the image
.github
docs
README.md
LICENSE
