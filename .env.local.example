BRAVE_SEARCH_API_KEY=your_brave_api_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CRM messaging providers (optional).
# Leave unset to run the inbox and automations in simulated mode — messages are
# recorded but not actually delivered. Set these to send for real.
# Email via Resend (https://resend.com):
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMS via Twilio (https://www.twilio.com):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Invoice payments (optional).
# Leave unset to generate simulated payment links. Set to create real Stripe
# Checkout links (https://stripe.com):
STRIPE_SECRET_KEY=

# AI estimator (optional).
# Leave unset to draft quote line items with a simple simulated estimate. Set to
# generate estimates with Claude (https://www.anthropic.com):
ANTHROPIC_API_KEY=
